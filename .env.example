# Copy to .env and fill in. Never commit .env.
MONGODB_URI=
MONGODB_DB=monsoonwatch
# Atlas Stream Processing workspace connection string (no credentials; the MONGODB_URI user is reused).
# That user needs the atlasAdmin role to create/run stream processors.
STREAM_PROCESSING_URI=
GEMINI_API_KEY=
# Only needed if not using Atlas-integrated Voyage:
VOYAGE_API_KEY=
API_PORT=8787
WEB_PORT=5173
MOCK=0
REGION_ID=kelantan
# B: start agent runs automatically from Stream Processing risk events (0 = off)
AGENT_AUTO_RUN=1
# Most villages sent to Gemini per agent run (rules planner covers the rest; default 10)
AGENT_GEMINI_MAX_VILLAGES=

# Read-only public deployment: blocks API writes and automatic agent runs.
PUBLIC_DEMO=0
# Saint (Thea) WhatsApp number with country code, e.g. 447700900000. Never commit the real one.
SAINT_WHATSAPP=
